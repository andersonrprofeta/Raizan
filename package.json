{
  "name": "raizan-core",
  "version": "0.5.5",
  "private": true,
  "author": "Raizan",
  "description": "Raizan Core App",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@mercadopago/sdk-react": "^1.0.7",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^13.1.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.20.0",
    "next": "16.2.0",
    "next-themes": "^0.4.6",
    "oracledb": "^6.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-quill-new": "^3.8.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "19.2.14",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4"
  },
  "build": {
    "appId": "com.raizancore.app",
    "productName": "Raizan Core",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "preload.js",
      "main.js",
      "package.json",
      "logo.ico",
      "node_modules/**/*",
      "!node_modules/@babel/**/*",
      "!node_modules/webpack/**/*",
      "!node_modules/@webassemblyjs/**/*",
      "!node_modules/next/dist/compiled/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    }
  },
  "publish": [
    {
      "provider": "github",
      "owner": "andersonrprofeta",
      "repo": "Raizan"
    }
  ]
}
